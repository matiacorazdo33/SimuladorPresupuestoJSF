<server description="SimuladorPresupuestoJSF">

    <featureManager>
        <feature>faces-4.0</feature>
        <feature>cdi-4.0</feature>
        <feature>beanValidation-3.0</feature>
        <feature>mail-2.1</feature>
        <feature>servlet-6.0</feature>
    </featureManager>

    <!--
        OJO: a propósito NO se declara la feature "persistence-3.1" (ni
        "jpa-3.1"). Este proyecto usa una unidad de persistencia
        RESOURCE_LOCAL y crea su propio EntityManagerFactory con Hibernate
        empaquetado en el WAR (ver EntityManagerProducer/UsuarioRepositorio
        y persistence.xml), así que no depende de que Liberty gestione la
        persistencia. Si se agrega esa feature, Liberty intenta ADEMÁS
        administrar el persistence.xml por su cuenta (vía
        persistenceContainer), lo cual choca con este enfoque y produce un
        NullPointerException interno de Liberty al arrancar.
    -->


    <httpEndpoint id="defaultHttpEndpoint"
                  httpPort="9080"
                  httpsPort="9443"/>

    <webApplication location="SimuladorPresupuestoJSF.war" contextRoot="/"/>

</server>
